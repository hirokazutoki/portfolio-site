---
import "../styles/global.css";
const homeUrl = new URL("/", Astro.site).toString();
const previewImageUrl = new URL("/preview.jpg", Astro.site).toString();
---

<!doctype html>
<html lang="en" class="m-0 w-full h-full">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<!-- Open Graph -->
		<meta property="og:type" content="website" />
		<meta property="og:description" content="hirokazutoki · about" />
		<meta property="og:url" content={homeUrl} />
		<meta property="og:image" content={previewImageUrl} />
		<meta property="og:image:type" content="image/jpeg" />
		<meta name="twitter:image" content={previewImageUrl} />
		<!-- Primary Meta Tags -->
		<title>hirokazutoki · about</title>
	</head>
	<body class="m-0 w-full h-full bg-zinc-950">
		<slot />
	</body>
</html>
