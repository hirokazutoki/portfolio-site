---
import "../styles/global.css";
const homeUrl = new URL("/", Astro.site).toString();
const appleTouchIconUrl = new URL("/apple-touch-icon.png", Astro.site).toString();
const previewImageUrl = new URL("/preview.jpg?t=2026041523", Astro.site).toString();

const lang = Astro.currentLocale ?? 'en';
---

<!doctype html>
<html lang={lang} class="m-0 w-full h-full">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" href={appleTouchIconUrl}>
		<meta name="generator" content={Astro.generator} />
		<!-- Open Graph -->
		<meta property="og:type" content="website" />
		<meta property="og:title" content="hirokazutoki · about" />
		<meta property="og:description" content="hirokazutoki · about" />
		<meta property="og:url" content={homeUrl} />
		<meta property="og:image" content={previewImageUrl} />
		<meta property="og:image:type" content="image/jpeg" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:site" content="@hirokazutoki">
		<meta name="twitter:image" content={previewImageUrl} />
		<meta name="twitter:title" content="hirokazutoki · about" />
		<!-- Social Media Verification -->
		<link rel="me" href="https://github.com/hirokazutoki" />
		<link rel="me" href="https://x.com/hirokazutoki" />
		<!-- Primary Meta Tags -->
		<title>hirokazutoki · about</title>
	</head>
	<body class="m-0 w-full h-full bg-zinc-950">
		<slot />
	</body>
</html>
