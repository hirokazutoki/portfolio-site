---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
const appleTouchIconUrl = new URL("/apple-touch-icon.png", Astro.site).toString();
const previewImageUrl = new URL("/preview.jpg?t=2026041523", Astro.site).toString();

import { t } from '../i18n/translations';
const lang = Astro.currentLocale ?? "ja";
const tr = t(lang);
const ogLocale = lang === "ja" ? "ja_JP" : "en_US";
const ogLocaleAlt = lang === "ja" ? "en_US" : "ja_JP";
const currentUrl = new URL(Astro.url.pathname, Astro.site).toString();

const personId = new URL('/#person', Astro.site).toString();

const jsonLd = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "WebPage",
			"@id": currentUrl,
			"url": currentUrl,
			"name": "hirokazutoki · about",
			"inLanguage": lang,
			"author": { "@id": personId }
		},
		{
			"@type": "Person",
			"@id": personId,
			"name": tr.name,
			"givenName": tr.givenName,
			"familyName": tr.familyName,
			"alternateName": tr.alternateName,
			"url": new URL('/', Astro.site).toString(),
			"jobTitle": tr.role,
			"sameAs": [
				"https://github.com/hirokazutoki",
				"https://x.com/hirokazutoki",
				"https://www.linkedin.com/in/hirokazutoki",
			]
		}
	]
};
---

<!doctype html>
<html lang={lang} class="m-0 w-full h-full">
	<head>
		<script is:inline>
			function applyTheme() {
				const saved = localStorage.getItem("theme");
				const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
				document.documentElement.setAttribute("data-theme", saved ?? (prefersDark ? "dark" : "light"));
			}
			applyTheme();
			// View Transitions でページ遷移すると <html> の属性がリセットされるため再セット
			document.addEventListener("astro:after-swap", applyTheme);
		</script>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" href={appleTouchIconUrl}>
		<meta name="generator" content={Astro.generator} />
		<!-- Open Graph -->
		<meta property="og:type" content="website" />
		<meta property="og:title" content="hirokazutoki · about" />
		<meta property="og:description" content="hirokazutoki · about" />
		<meta property="og:locale" content={ogLocale} />
		<meta property="og:locale:alternate" content={ogLocaleAlt} />
		<meta property="og:url" content={currentUrl} />
		<link rel="alternate" hreflang="ja" href={new URL('/', Astro.site)} />
		<link rel="alternate" hreflang="en" href={new URL('/en', Astro.site)} />
		<link rel="alternate" hreflang="x-default" href={new URL('/', Astro.site)} />
		<meta property="og:image" content={previewImageUrl} />
		<meta property="og:image:type" content="image/jpeg" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:site" content="@hirokazutoki">
		<meta name="twitter:image" content={previewImageUrl} />
		<meta name="twitter:title" content="hirokazutoki · about" />
		<!-- Social Media Verification -->
		<link rel="me" href="https://github.com/hirokazutoki" />
		<link rel="me" href="https://x.com/hirokazutoki" />
		<link rel="me" href="https://www.linkedin.com/in/hirokazutoki" />
		<!-- Structured Data -->
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

		<ClientRouter />
		<!-- Primary Meta Tags -->
		<title>hirokazutoki · about</title>
	</head>
	<body class="m-0 w-full h-full">
		<slot />
	</body>
</html>
