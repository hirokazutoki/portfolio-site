---
import BaseLayout from "../../layouts/Layout.astro";

const allArticles = Object.values(import.meta.glob('../articles/*.md', { eager: true }))
const tags = [...new Set(allArticles.map((article: any) => article.frontmatter.tags).flat())];
---
<BaseLayout>
  <main class="flex-1">
    <div class="max-w-5xl mx-auto px-6 sm:px-6 md:px-8 py-16 sm:py-20 md:py-32">
      <div class="tags">
        {tags.map((tag) => (
          <p class="tag"><a href={`/tags/${tag}`}>{tag}</a></p>
        ))}
      </div>
    </div>
  </main>
</BaseLayout>
<style>
    a {
        color: var(--text-muted);
    }

    .tags {
        display: flex;
        flex-wrap: wrap;
    }

    .tag {
        margin: 0.25em;
        border: dotted 1px var(--text-muted);
        border-radius: .5em;
        padding: .25em .5em;
        background-color: var(--bg-muted);
    }

    .tag::before {
        content: "# ";
        color: var(--text-muted);
    }
</style>