---
import BaseLayout from '../../layouts/Layout.astro';
export async function getStaticPaths() {
  const allArticles = Object.values(
    import.meta.glob<{ frontmatter: { title: string; tags?: string[] }; url: string }>(
      '../articles/*.md',
      { eager: true }
    )
  );

  const uniqueTags = [...new Set(allArticles.map((article: any) => article.frontmatter.tags).flat())];

  return uniqueTags.map((tag) => {
    const filteredArticles = allArticles.filter((article: any) => article.frontmatter.tags.includes(tag));
    return {
      params: { tag },
      props: { articles: filteredArticles },
    };
  });
}

const { tag } = Astro.params;
const { articles } = Astro.props;
---
<BaseLayout pageTitle={tag}>
    <main class="flex-1">
        <div class="max-w-5xl mx-auto px-6 sm:px-6 md:px-8 py-16 sm:py-20 md:py-32">
            <p>Articles tagged with {tag}</p>
            <ul>
              {articles.map((article) => <li><a href={article.url}>{article.frontmatter.title}</a></li>)}
            </ul>
        </div>
    </main>
</BaseLayout>