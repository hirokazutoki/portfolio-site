---
import Layout from '../../layouts/Layout.astro';

const allArticles = Object.values(import.meta.glob('../../pages/articles/*.md', { eager: true }));

import profile from '../../assets/profile.jpg';
import { t } from '../../i18n/translations';

const lang = Astro.currentLocale ?? 'ja';
const tr = t(lang);
---

<Layout>
    <main class="flex-1">
        <div class="max-w-5xl mx-auto px-6 sm:px-6 md:px-8 py-16 sm:py-20 md:py-32">
            <div class="flex flex-col sm:flex-row sm:gap-8 md:gap-16 lg:gap-20 items-start">
                <div>
                    <h1>My Astro Learning Blog</h1>
                    <p>This is where I will post about my journey learning Astro.</p>
                    <ul>
                      {allArticles.map((article: any) => <li><a href={article.url}>{article.frontmatter.title}</a></li>)}
                    </ul>
                </div>
            </div>
        </div>
    </main>

</Layout>
