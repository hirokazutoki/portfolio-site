---
import { version, repository } from '../../package.json';
---

<footer>
	<div class="max-w-5xl mx-auto px-7 md:px-8">
		<div class="flex items-center justify-between h-14 text-(--text-footer)">
			<div>© Hirokazu Toki</div>
			<div>
				<a class="flex items-center gap-1 text-sm"
					 href={`${repository.url}/releases`}
					 target="_blank" rel="noopener noreferrer" aria-label="GitHub"
				>
					<i class="fa-solid fa-code-branch"></i>
					<span>v{version}</span>
				</a>
			</div>
		</div>
	</div>
</footer>
