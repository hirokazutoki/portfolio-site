---

import logo from '../assets/logo-360px.png';
import profile from '../assets/profile.jpg';
---

<div class="bg-zinc-950 min-h-dvh flex flex-col">
	<header class="sticky top-0 w-full bg-zinc-900/80">
		<div class="max-w-5xl mx-auto px-4 sm:px-6 md:px-8">

			<div class="flex items-center justify-between h-14">
				<div class="flex items-center gap-0.5">
					<img src={logo.src} alt="logo image" class="w-10 h-10" />
					<a href="/" class="text-white font-semibold text-md sm:text-base no-underline hover:text-amber-400">hirokazutoki</a>
				</div>
				<nav>
					<ul>
						<li><a href="/" class="px-3 py-1.5 uppercase no-underline tracking-wide text-md bg-white">Profile</a></li>
					</ul>
				</nav>
			</div>
		</div>
	</header>
	<main class="flex-1">
		<div class="max-w-5xl mx-auto px-6 sm:px-6 md:px-8 py-12 sm:py-20 md:py-32">
			<div class="flex flex-col md:flex-row gap-12 md:gap-16 lg:gap-20 items-start">
				<div class="w-full md:w-5/12 shrink-0">
					<img src={profile.src} alt="profile" class="w-full rounded" />
				</div>
				<div>
					<h1 class="text-5xl md:text-6xl text-white tracking-tight text-balanc">Hirokazu Toki</h1>
					<p class="text-lg text-zinc-400 mt-3">Web Application Developer</p>
				</div>
			</div>
		</div>
	</main>
	<footer class="border-t border-white/10">
		<div class="flex justify-center items-center h-14">
			<div class="text-zinc-600 text-base sm:text-sm">Copyright 2026, Hirokazu Toki.</div>
		</div>
	</footer>
</div>
