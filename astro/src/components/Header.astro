---
import logo from '../assets/logo-360px.png';
import { t } from '../i18n/translations';
import { getRelativeLocaleUrl } from 'astro:i18n';

const lang = Astro.currentLocale ?? 'ja';
const otherLang = lang === 'en' ? 'ja' : 'en';
const homeUrl = getRelativeLocaleUrl(lang, '/');
const switchUrl = getRelativeLocaleUrl(otherLang, '/');
const switchLang = lang === 'en' ? '日本語' : 'English';
---

<header style="background-color: var(--bg);" class="fixed top-0 w-full">
	<div class="max-w-5xl mx-auto px-4 sm:px-6 md:px-8">
		<div class="flex items-center justify-between h-14">
			<div class="flex items-center gap-0.5">
				<img src={logo.src} alt="logo image" class="w-10 h-10" />
				<a href={homeUrl} class="font-semibold text-md sm:text-base no-underline hover:text-accent-color">hirokazutoki</a>
			</div>
			<nav class="flex items-center gap-3">
				<div class="hover:text-accent-color">
					<a id="langSwitch" href={switchUrl}>{switchLang}</a>
				</div>
				<button id="themeToggle" aria-label="Toggle theme" class="w-8 h-8 flex items-center justify-center hover:text-accent-color cursor-pointer">
					<svg class="icon-sun w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<circle cx="12" cy="12" r="5" />
						<line x1="12" y1="1"  x2="12" y2="3" />
						<line x1="12" y1="21" x2="12" y2="23" />
						<line x1="4.22" y1="4.22" x2="5.64" y2="5.64" />
						<line x1="18.36" y1="18.36" x2="19.78" y2="19.78" />
						<line x1="1"  y1="12" x2="3"  y2="12" />
						<line x1="21" y1="12" x2="23" y2="12" />
						<line x1="4.22" y1="19.78" x2="5.64" y2="18.36" />
						<line x1="18.36" y1="5.64" x2="19.78" y2="4.22" />
					</svg>
					<svg class="icon-moon w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
					</svg>
				</button>
				<!-- TODO -->
				<ul class="hidden">
					<li><a href="/" class="px-3 py-1.5 uppercase no-underline tracking-wide text-md bg-white">Profile</a></li>
				</ul>
			</nav>
		</div>
	</div>
</header>
