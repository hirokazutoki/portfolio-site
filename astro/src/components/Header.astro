---
import { t } from '../i18n/translations';
import { getRelativeLocaleUrl } from 'astro:i18n';

const lang = Astro.currentLocale ?? 'ja';
const otherLang = lang === 'en' ? 'ja' : 'en';
const homeUrl = getRelativeLocaleUrl(lang, '/');
const switchUrl = getRelativeLocaleUrl(otherLang, '/');
const switchLang = lang === 'en' ? '日本語' : 'English';
---

<header style="background-color: var(--bg);" class="fixed top-0 w-full">
	<div class="max-w-5xl mx-auto px-6 sm:px-6 md:px-8">
		<div class="flex items-center justify-between h-14">
			<div class="flex items-center gap-0.5">
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 305 305" class="w-6 h-6 me-1.5" aria-hidden="true">
					<style>
						.logo-bg { fill: #09090B; }
						.logo-fg { fill: #FBCF50; }
						:root[data-theme="light"] .logo-bg { fill: #FBCF50; }
						:root[data-theme="light"] .logo-fg { fill: #2A2A2A; }
					</style>
					<path class="logo-bg" d="M0 0 C100.65 0 201.3 0 305 0 C305 100.65 305 201.3 305 305 C204.35 305 103.7 305 0 305 C0 204.35 0 103.7 0 0 Z"/>
					<path class="logo-fg" d="M0 0 C11.55 0 23.1 0 35 0 C35 18.81 35 37.62 35 57 C39.95 54.36 44.9 51.72 50 49 C58.52922666 44.4920704 64.51580906 43.29488173 74.10546875 43.51171875 C75.71065369 43.51927185 75.71065369 43.51927185 77.3482666 43.52697754 C81.29495549 43.55287537 85.24125847 43.62267962 89.1875 43.6875 C98.035625 43.790625 106.88375 43.89375 116 44 C116 71.72 116 99.44 116 128 C104.78 128 93.56 128 82 128 C82 108.2 82 88.4 82 68 C67.47192539 74.97347581 52.99915751 81.92544693 38.66625977 89.27246094 C37 90 37 90 35 90 C35 102.54 35 115.08 35 128 C23.45 128 11.9 128 0 128 C0 85.76 0 43.52 0 0 Z" transform="translate(51,88)"/>
					<path class="logo-fg" d="M0 0 C43.89 0 87.78 0 133 0 C129.535 5.94 129.535 5.94 126 12 C124.81083984 14.85398437 124.81083984 14.85398437 123.59765625 17.765625 C120.97282964 23.74257339 118.35742217 29.0506586 113 33 C107.44120868 34.19092593 102.14103603 33.92962135 96.49609375 33.609375 C94.99131132 33.56039617 93.48637515 33.51592203 91.98132324 33.47607422 C88.31765426 33.36934192 84.65982039 33.20154882 81 33 C81.03330917 33.91962021 81.06661835 34.83924042 81.10093689 35.78672791 C81.40228736 44.48041215 81.63023454 53.17232955 81.77718258 61.87004757 C81.85528135 66.34150424 81.9610325 70.80862692 82.1315918 75.27758789 C82.29537312 79.59630324 82.38440397 83.91087231 82.42315865 88.2324543 C82.45074439 89.87521271 82.50463223 91.5177589 82.58595085 93.15873528 C82.8382858 98.46494424 82.797233 102.95752055 81 108 C77.36933321 111.88068353 72.61757434 114.06006033 67.81655693 116.16921234 C65.28352356 117.32767472 62.97368494 118.78226179 60.6328125 120.28515625 C59.87355469 120.75244141 59.11429688 121.21972656 58.33203125 121.70117188 C56.80535287 122.64284872 55.27935511 123.58562958 53.75390625 124.52929688 C53.01269531 124.98498047 52.27148438 125.44066406 51.5078125 125.91015625 C50.85441895 126.31371338 50.20102539 126.71727051 49.52783203 127.13305664 C48 128 48 128 47 128 C47 96.32 47 64.64 47 32 C31.49 32 15.98 32 0 32 C0 21.44 0 10.88 0 0 Z" transform="translate(133,88)"/>
				</svg>
				<a href={homeUrl} class="font-semibold text-md sm:text-base no-underline hover:text-accent-color">hirokazutoki</a>
			</div>
			<nav class="flex items-center gap-3">
				<div class="hover:text-accent-color">
					<a id="langSwitch" href={switchUrl}>{switchLang}</a>
				</div>
				<button id="themeToggle" aria-label="Toggle theme" class="w-8 h-8 flex items-center justify-center hover:text-accent-color cursor-pointer">
					<svg class="icon-sun w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<circle cx="12" cy="12" r="5" />
						<line x1="12" y1="1"  x2="12" y2="3" />
						<line x1="12" y1="21" x2="12" y2="23" />
						<line x1="4.22" y1="4.22" x2="5.64" y2="5.64" />
						<line x1="18.36" y1="18.36" x2="19.78" y2="19.78" />
						<line x1="1"  y1="12" x2="3"  y2="12" />
						<line x1="21" y1="12" x2="23" y2="12" />
						<line x1="4.22" y1="19.78" x2="5.64" y2="18.36" />
						<line x1="18.36" y1="5.64" x2="19.78" y2="4.22" />
					</svg>
					<svg class="icon-moon w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
					</svg>
				</button>
				<!-- TODO -->
				<ul class="hidden">
					<li><a href="/" class="px-3 py-1.5 uppercase no-underline tracking-wide text-md bg-white">Profile</a></li>
				</ul>
			</nav>
		</div>
	</div>
</header>
