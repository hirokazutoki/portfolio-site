---
import profile from '../../assets/profile.jpg';
import { t } from '../../i18n/translations';

const lang = Astro.currentLocale ?? 'ja';
const tr = t(lang);
---

<main class="flex-1">
	<div class="max-w-5xl mx-auto px-6 sm:px-6 md:px-8 py-16 sm:py-20 md:py-32">
		<div class="flex flex-col md:flex-row gap-12 md:gap-16 lg:gap-20 items-start">
			<div class="w-full md:w-5/12 shrink-0">
				<img src={profile.src} alt="profile" class="w-full rounded" />
			</div>
			<div>
				<h1 class="text-5xl md:text-6xl tracking-tight text-balanc">{tr.name}</h1>
				<p class="text-lg text-(--text-muted) mt-3">{tr.role}</p>
			</div>
		</div>
	</div>
</main>
